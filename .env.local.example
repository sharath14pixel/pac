# ─────────────────────────────────────────────────────────────
# BitGN platform
# ─────────────────────────────────────────────────────────────
# Get your key from your BitGN profile:  https://bitgn.com/profile
BITGN_API_KEY=your-bitgn-api-key-here
BENCHMARK_HOST=https://api.bitgn.com

# Practice / development:    bitgn/pac1-dev
# Scored competition:        bitgn/pac1-prod
BENCHMARK_ID=bitgn/pac1-dev

# ─────────────────────────────────────────────────────────────
# LLM provider — pick one (or configure both for fallback)
# ─────────────────────────────────────────────────────────────
# Anthropic Claude (default, used when MODEL_ID starts with "claude-")
ANTHROPIC_API_KEY=your-anthropic-key-here

# OpenAI (used when MODEL_ID starts with "gpt-" or "o")
OPENAI_API_KEY=your-openai-key-here

# Model selection. See src/agent.ts getModel() for routing rules.
#   claude-sonnet-4-6  (default, recommended balance of quality & speed)
#   claude-opus-4-6    (highest quality, slower & more expensive)
#   claude-haiku-4-5   (fastest, cheapest, slightly lower quality)
#   gpt-4.1            (GPT-4.1 via direct OpenAI)
MODEL_ID=claude-sonnet-4-6

# ─────────────────────────────────────────────────────────────
# Runtime behavior
# ─────────────────────────────────────────────────────────────
# MAX_STEPS=30                  # Max tool calls per task (default 30)
# CONCURRENCY=1                 # Intra-run trial parallelism (default 1)
# VERBOSE=false                 # Dump full prompts, tool I/O, token counts

# ─────────────────────────────────────────────────────────────
# Track-B hardening layers (all default ON, set "false" to disable)
# ─────────────────────────────────────────────────────────────
# ENABLE_SECURITY_SCAN=true            # Injection + phishing scanner
# ENABLE_PATH_GUARD=true               # B1 — path-traversal guard
# ENABLE_PII_REFUSAL=true              # B2 — PII refusal routing
# ENABLE_REFS_VALIDATION=true          # B3 — grounding-refs self-validation (warn-only)
# ENABLE_REFS_VALIDATION_STRICT=false  # B3 — upgrade warn-only to blocking
# ENABLE_DESTRUCTIVE_BRAKE=true        # B4 — destructive-action + exploration-spiral brakes
# ENABLE_SECRET_REDACTION=true         # B5 — vendor-secret redaction
# EXPLORATION_SPIRAL_THRESHOLD=35      # B4 — soft cap on consecutive read/search calls

# ─────────────────────────────────────────────────────────────
# Run-metrics (JSONL telemetry per task)
# ─────────────────────────────────────────────────────────────
# ENABLE_RUN_METRICS=true              # Set false to skip JSONL writing
# RUN_METRICS_PATH=.bitgn/runs         # Override metrics output directory
